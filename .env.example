# Copy this file to .env and fill in your own values.
# Azure app registration (see "Authentication" in README.md)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
# OpenAI API key
OPENAI_API_KEY=
# Optional: your timezone for after-hours stats in the email pipeline
# (IANA name, e.g. America/New_York). Defaults to this computer's UTC offset.
LOCAL_TIMEZONE=
